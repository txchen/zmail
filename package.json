{
  "name": "zmail",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"vp run --filter @zmail/api dev\" \"vp dev apps/web --host 0.0.0.0\"",
    "test": "vp test",
    "typecheck": "tsc -b",
    "check": "vp check"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "hono": "^4.6.14",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^8.0.10",
    "vite-plus": "^0.1.19",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.0"
}
