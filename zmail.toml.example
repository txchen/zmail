# To start with no Mail accounts, replace the [[mail_accounts]] block below with:
# mail_accounts = []
#
# Keep mail_accounts at the top level, before [app_login].

[storage]
database_dir = ".data"

[sync]
# Optional, defaults to 90. Valid range: 1..3650.
recent_message_window_days = 90

[app_login]
username = "reader"
password = "change-me"
session_secret = "replace-with-at-least-16-random-characters"
# Optional, defaults to 365. Valid range: 1..3650.
# session_ttl_days = 365

[[mail_accounts]]
id = "personal"
email_address = "me@example.com"
app_password = "replace-with-gmail-app-password"
